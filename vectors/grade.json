      "prices": [
        { "t": 1790000060, "price": 98 },
        { "t": 1790000120, "price": 93.8 }
      ],
      "expected": {
        "status": "win",
        "reason": "tp",
        "resolvedAt": 1790000120,
        "exit": 93.8,
        "returnPct": 6.2000000000000055
      }
    },
