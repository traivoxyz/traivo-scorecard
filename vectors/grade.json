      "name": "sell_sl_first",
      "call": { "side": "sell", "entry": 100, "stop": 103, "target": 94, "createdAt": 1790000000, "horizonS": 604800 },
      "prices": [
        { "t": 1790000060, "price": 101 },
        { "t": 1790000120, "price": 103.5 },
        { "t": 1790000180, "price": 90 }
      ],
      "expected": {
        "status": "loss",
        "reason": "sl",
        "resolvedAt": 1790000120,
        "exit": 103.5,
        "returnPct": -3.499999999999992
      }
    },
    {
      "name": "sell_exact_target",
      "call": { "side": "sell", "entry": 100, "stop": 103, "target": 94, "createdAt": 1790000000, "horizonS": 604800 },
      "prices": [{ "t": 1790000060, "price": 94 }],
      "expected": {
        "status": "win",
        "reason": "tp",
        "resolvedAt": 1790000060,
        "exit": 94,
        "returnPct": 6.000000000000005
      }
    },
    {
      "name": "sell_exact_stop",
      "call": { "side": "sell", "entry": 100, "stop": 103, "target": 94, "createdAt": 1790000000, "horizonS": 604800 },
      "prices": [{ "t": 1790000060, "price": 103 }],
      "expected": {
        "status": "loss",
        "reason": "sl",
        "resolvedAt": 1790000060,
        "exit": 103,
        "returnPct": -3.0000000000000027
      }
    },
    {
      "name": "sell_gap_through_stop",
      "call": { "side": "sell", "entry": 100, "stop": 103, "target": 94, "createdAt": 1790000000, "horizonS": 604800 },
      "prices": [{ "t": 1790000060, "price": 120 }],
      "expected": {
        "status": "loss",
